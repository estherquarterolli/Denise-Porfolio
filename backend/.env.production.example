# ==============================================================================
# Configurações de Produção - Denise Portfolio (deniseana.com.br)
# Salve no servidor em: /opt/denise-portfolio/backend/.env.production
# ==============================================================================

# --- Banco de dados (PostgreSQL compartilhado no docker-compose) ---
# O host "postgres" resolve diretamente o container postgres-vdb na mesma rede.
# Substitua SUA_SENHA_POSTGRES pela senha real do POSTGRES_PASSWORD no seu servidor.
DATABASE_URL=postgresql+psycopg2://postgres:SUA_SENHA_POSTGRES@postgres:5432/denise_portfolio

# Caso queira usar SQLite em vez de Postgres (totalmente independente de outro container):
# DATABASE_URL=sqlite:////app/backend/uploads/denise_portfolio.db

# --- Autenticação JWT ---
# Gere uma chave aleatória no Linux: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-string-aleatoria-e-longa-de-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Usuário admin inicial (criado no primeiro boot pelo init_db.py) ---
ADMIN_USERNAME=denise
ADMIN_PASSWORD=DefinaUmaSenhaForteParaProducaoAqui

# --- Upload de imagens ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# --- E-mail (formulário de contato via SMTP) ---
# Opcional: configure se quiser receber as mensagens enviadas no site por e-mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
CONTACT_RECEIVER_EMAIL=denise@deniseana.com.br

# --- CORS e Domínio ---
FRONTEND_ORIGIN=https://deniseana.com.br,https://www.deniseana.com.br

# --- Ambiente ---
# "production" desativa /docs e /openapi.json e ativa HSTS e headers de segurança
ENVIRONMENT=production
