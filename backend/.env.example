# --- Banco de dados (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/denise_portfolio

# --- Autenticação JWT ---
# Gere uma chave forte com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-string-aleatoria-e-secreta
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Usuário admin inicial (criado automaticamente por init_db.py) ---
ADMIN_USERNAME=denise
ADMIN_PASSWORD=troque-esta-senha

# --- Upload de imagens ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# --- E-mail (formulário de contato via SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASSWORD=sua-senha-de-app
CONTACT_RECEIVER_EMAIL=denise@example.com

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:8000
