# Ambientes virtuais e caches Python
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Arquivos de ambiente e credenciais (NUNCA comitar)
.env
.env.*
!.env.example
!.env.production.example
backend/.env
backend/.env.*
