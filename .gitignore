!backend/.env.production.example

# Bancos de dados locais e logs
*.db
*.sqlite3
*.log
backend/*.log

# Uploads locais de mídia (preserva o .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# Arquivos de testes locais
test-results/

# Sistema operacional
.DS_Store
Thumbs.db
