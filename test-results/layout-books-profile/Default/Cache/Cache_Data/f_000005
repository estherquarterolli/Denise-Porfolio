function updateCareerWorm() {
  if (!careerTimelineWrap || !careerWorm || !careerWormPath) return;
  const nodes = [...careerTimeline.querySelectorAll(".timeline-node")];
  const wrapRect = careerTimelineWrap.getBoundingClientRect();
  const width = careerTimelineWrap.clientWidth;
  const height = careerTimelineWrap.scrollHeight;
  careerWorm.setAttribute("viewBox", `0 0 ${width} ${height}`);

  const points = nodes.map((node) => {
    const rect = node.getBoundingClientRect();
    return {
      x: rect.left - wrapRect.left + rect.width / 2,
      y: rect.top - wrapRect.top + rect.height / 2,
    };
  });
  if (!points.length) {
    careerWormPath.setAttribute("d", "");
    return;
  }

  let path = `M ${points[0].x} ${points[0].y}`;
  for (let index = 1; index < points.length; index += 1) {
    const previous = points[index - 1];
    const current = points[index];
    const middleY = (previous.y + current.y) / 2;
    path += ` C ${previous.x} ${middleY}, ${current.x} ${middleY}, ${current.x} ${current.y}`;
  }
  careerWormPath.setAttribute("d", path);
}

let careerWormFrame = 0;
function scheduleCareerWorm() {
  cancelAnimationFrame(careerWormFrame);
  careerWormFrame = requestAnimationFrame(updateCareerWorm);
}

function renderCareer(content) {
  const timeline = [...(content.timeline || [])].sort((a, b) => a.order - b.order);
  careerTimeline.innerHTML = timeline.map((item) => `
